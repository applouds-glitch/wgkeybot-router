config wgkeybot 'main'
	# Включить туннель (procd запустит демон только при enabled=1).
	option enabled '0'

	# Режим: 'gateway' — весь трафик LAN-клиентов через туннель;
	#        'socks'   — локальный SOCKS5 без изменения системной маршрутизации.
	option mode 'gateway'

	# Имя TUN-интерфейса.
	option ifname 'wgkb0'

	# MTU туннеля (1280 по умолчанию из-за DTLS/TURN-оверхеда).
	option mtu '1280'

	# Порт локального SOCKS5 (режим 'socks').
	option socks_port '1080'

	# Имя network-интерфейса OpenWrt, чьи клиенты заворачиваются в туннель (gateway).
	option lan 'lan'

	# fwmark для сокетов прокси (их трафик уходит мимо туннеля на WAN).
	option fwmark '0x4b8'

	# Номер таблицы маршрутизации для gateway-режима.
	option table '51820'

	# Подстраховочный nft-masquerade демоном (1) в дополнение к fw4-зоне.
	# Поставьте 0, если NAT для wgkb0 настраиваете только через firewall.
	option nat '1'

	# Адрес страницы решения captcha (открывается с устройства в LAN).
	option captcha_listen '0.0.0.0:8089'

	# Порт встроенной веб-панели на LAN (статус, импорт конфига, reconnect).
	# 0 — выключить панель и пользоваться только LuCI.
	option panel_port '1441'
